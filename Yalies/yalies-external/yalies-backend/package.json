  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "compression": "^1.8.1",
    "connect-session-sequelize": "github:ericyoondotcom/connect-session-sequelize",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^2.1.1",
