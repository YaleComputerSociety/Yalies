# Copy to .config/internal/.env.data-pipeline.
# Required: development database, private session secret, and dashboard origin.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:1357/postgres
SESSION_SECRET=replace-with-a-different-random-secret
AUTH_MODE=dev
DASHBOARD_URL=http://localhost:3001
NODE_ENV=development
# Optional; defaults to 8080.
PORT=8080
# The first server startup seeds yef3 as the only admin.
DEV_NETID=yef3
# Production: AUTH_MODE=cas, NODE_ENV=production, and an HTTPS DASHBOARD_URL.
# The combined admin service uses the same origin for the dashboard and API.
# PIPELINE_URL is only needed when the API uses a different origin.
