# Copy to .config/internal/.env.data-pipeline.
# Required: development database, private session secret, and dashboard origin.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:1357/postgres
SESSION_SECRET=replace-with-a-different-random-secret
AUTH_MODE=dev
DASHBOARD_URL=http://localhost:3001
NODE_ENV=development
# Optional; defaults to 8080.
PORT=8080
# Required for the development identity; must exist in the admin table.
DEV_NETID=yournetid
