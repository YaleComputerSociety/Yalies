# Copy to .config/external/.env.backend.development.
# Required: use a development database and a private random session secret.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:1357/postgres
SESSION_SECRET=replace-with-a-random-secret
PORT=1337
NODE_ENV=development
AUTH_MODE=dev
DEV_NETID=yournetid
FRONTEND_URL=http://localhost:3000
ADMIN_NETIDS=yournetid
# Optional features. Enable only after completing their setup.
OIDC_ENABLED=false
FACECHECK_ENABLED=false
# FACECHECK_PYTHON=/absolute/path/to/python
# FACECHECK_SCRIPT=/absolute/path/to/facecheck.py
