{
  "name": "yalies-backend",
  "version": "2.0.0",
  "description": "Yale people directory",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "node build/index.js",
    "build": "tsc",
    "dev": "npm run build && NODE_ENV=development npm start",
    "lint": "eslint src/**/*.ts",
    "format": "eslint src/**/*.ts --fix",
    "deploy": "bash ../../scripts/deploy/api.sh",
    "test:oidc": "npm run build && node --test tests/oidc.test.mjs",
    "oidc:register": "npm run build && node scripts/register-oidc-client.mjs",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run build:shared --prefix ../..",
    "test:integration": "npm run build && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yalies/Yalies.git"
  },
  "keywords": [
    "Yale"
  ],
  "author": "Erik Boesen, Yale Computer Society",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Yalies/Yalies/issues"
  },
  "homepage": "https://github.com/Yalies/Yalies#readme",
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "compression": "^1.8.1",
    "connect-session-sequelize": "git+https://github.com/ericyoondotcom/connect-session-sequelize.git#ad53e554736c530104d9e3b4b07d8b3584f6a043",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^2.1.1",
    "oidc-provider": "9.12.2",
    "passport": "^0.7.0",
    "passport-cas": "git+https://github.com/coursetable/passport-cas.git#98566236fbc9a0b17bda70b581efa1a14f748fe7",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "yalies-shared": "1.0.0",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin-js": "^2.10.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^2.1.0",
    "@types/oidc-provider": "^9.12.1",
    "@types/passport": "^1.0.16",
    "@types/passport-strategy": "^0.2.38",
    "eslint": "^8.57.0",
    "eslint-plugin-github": "^5.0.1",
    "typescript": "^5.5.4"
  },
  "private": true
}
